{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "mailfare",
	"main": "./worker.ts",
	"compatibility_date": "2026-05-20",
	"routes": [
		// Custom domain for the app. The old tunnel CNAME was removed so the
		// Worker serves mail.akamasocial.online directly (inbound email also
		// no longer depends on the tunnel).
		{
			"pattern": "mail.akamasocial.online",
			"custom_domain": true,
		},
	],
	// Keep the workers.dev URL enabled alongside the custom domain
	// (adding a custom domain disables workers.dev by default).
	"workers_dev": true,
	// Silence the Preview URLs warning; this app doesn't use them.
	"preview_urls": false,
	"keep_vars": true,
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"assets": {
		"binding": "ASSETS",
		"directory": ".open-next/assets",
	},
	"images": {
		"binding": "IMAGES",
	},
	"services": [
		{
			"binding": "WORKER_SELF_REFERENCE",
			"service": "mailfare",
		},
	],
	"durable_objects": {
		"bindings": [
			{
				"name": "REALTIME",
				"class_name": "MailflareRealtimeHub",
			},
		],
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": [
				"RealtimeHub",
			],
		},
		// The published script still has live Durable Object instances that
		// depend on the `RealtimeHub` class (error 10064), so the class must
		// be renamed rather than re-created — a rename migrates existing
		// instances to the new class name.
		{
			"tag": "v3-readd-realtime",
			"renamed_classes": [
				{
					"from": "RealtimeHub",
					"to": "MailflareRealtimeHub",
				},
			],
		},
	],
	"workflows": [
		{
			"name": "mailflare-database-backup",
			"binding": "DATABASE_BACKUP_WORKFLOW",
			"class_name": "DatabaseBackupWorkflow",
			// NOTE: `schedules` on Workflows require a paid Workers plan. The
			// daily 02:00 UTC run is handled by the free cron trigger below,
			// which starts the workflow via the `scheduled()` handler.
		},
	],
	"triggers": {
		"crons": [
			"0 2 * * *",
		],
	},
	"ratelimits": [
		{
			"name": "LOGIN_RATE_LIMIT",
			"namespace_id": "1001",
			"simple": {
				"limit": 20,
				"period": 60,
			},
		},
	],
	"observability": {
		"enabled": true,
	},
	"upload_source_maps": true,
	"send_email": [
		{
			"name": "EMAIL",
			"remote": true,
		},
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "mailflare",
			"database_id": "cf7c2ddc-c274-42db-999d-dbc526f2e0d7",
			"migrations_dir": "drizzle/migrations",
		},
	],
	"r2_buckets": [
		{
			"binding": "BUCKET",
			"bucket_name": "mailflare-raw",
		},
	],
	"queues": {
		"producers": [
			{
				"binding": "INBOUND_QUEUE",
				"queue": "mailflare-inbound",
			},
			{
				"binding": "OUTBOUND_QUEUE",
				"queue": "mailflare-outbound",
			},
		],
		"consumers": [
			{
				"queue": "mailflare-inbound",
				"max_batch_size": 5,
				"max_retries": 3,
			},
			{
				"queue": "mailflare-outbound",
				"max_batch_size": 5,
				"max_retries": 3,
			},
		],
	},
	"vars": {
		// Service sender for /api/transactional (akama-2 verification mail).
		// MAILFARE_TX_KEY is a secret: `wrangler secret put MAILFARE_TX_KEY` (never commit it here).
		"MAILFARE_TX_FROM": "Akama <verify@mail.akamasocial.online>"
	}
}
